# ==========================================
# ResuMesh Client Backend - Environment Configuration
# ==========================================

# ------------------------------------------
# General Application Settings
# ------------------------------------------
APP_NAME="ResuMesh API Core"
APP_ENV="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# ------------------------------------------
# Database Connection Settings
# ------------------------------------------
# SQLite Local Development Fallback:
DATABASE_URL="sqlite:///./resumesh_dev.db"

# PostgreSQL / Supabase Connection Example:
# DATABASE_URL="postgresql://postgres:resumesh_password@localhost:5432/resumesh"

# ------------------------------------------
# Supabase & Cloud Storage Configuration
# ------------------------------------------
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_KEY="your-supabase-anon-or-service-key"
SUPABASE_JWT_SECRET="your-supabase-jwt-secret-key-min-32-chars"

# ------------------------------------------
# Authentication & Security Settings
# ------------------------------------------
JWT_SECRET_KEY="resumesh_secret_key_development_only_change_in_production"
ADMIN_USERNAME="admin@resumesh.dev"
ADMIN_PASSWORD="password123"

# ------------------------------------------
# CORS & Network Policy Settings
# ------------------------------------------
CORS_ORIGINS="http://localhost:8080,http://localhost:3000,http://127.0.0.1:8080,http://127.0.0.1:3000"

# ------------------------------------------
# Telemetry & Logging Settings
# ------------------------------------------
SENTRY_DSN=""
LOG_LEVEL="INFO"

# ------------------------------------------
# AI Provider Integration (Groq / OpenAI / Ollama / Mock)
# ------------------------------------------
LLM_PROVIDER="mock"
OPENAI_API_KEY=""
GROQ_API_KEY=""
OLLAMA_HOST="http://localhost:11434"
