# =============================================================================
# ResuMesh Client Backend - Environment Example (Supabase PostgreSQL Centric)
# =============================================================================

APP_NAME="ResuMesh Visitor API"
ENVIRONMENT="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# Supabase PostgreSQL Connection String
# Local Supabase CLI default: postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Supabase Cloud default: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# Supabase Storage & API Credentials
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_KEY="YOUR_SUPABASE_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"
SUPABASE_JWT_SECRET="YOUR_SUPABASE_JWT_SECRET"

# CORS Allowed Origins
CORS_ORIGINS="http://localhost:8080,http://localhost:3000,http://127.0.0.1:8080,http://127.0.0.1:3000"

# Logging & Monitoring
LOG_LEVEL="INFO"
SENTRY_DSN=""
