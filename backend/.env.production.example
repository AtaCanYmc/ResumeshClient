# =============================================================================
# ResuMesh Client Backend - Production Environment Template
# =============================================================================

APP_NAME="ResuMesh Visitor API"
ENVIRONMENT="production"
DEBUG=false
PORT=8000
HOST="0.0.0.0"

# Supabase Production PostgreSQL Connection String
DATABASE_URL="postgresql://postgres:YOUR_SUPABASE_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"

# Supabase Cloud Storage & Auth Configuration
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_KEY="YOUR_SUPABASE_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"
SUPABASE_JWT_SECRET="YOUR_SUPABASE_JWT_SECRET_KEY"

# Production CORS Allowed Origins
CORS_ORIGINS="https://yourdomain.com,https://www.yourdomain.com"

# Logging & Monitoring
LOG_LEVEL="INFO"
SENTRY_DSN="https://your-sentry-dsn.ingest.sentry.io/123456"
