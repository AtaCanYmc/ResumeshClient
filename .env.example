# Backend Configuration
APP_NAME="ResuMesh Client API"
ENVIRONMENT="development"
DEBUG=true
LOG_LEVEL="INFO"
CORS_ORIGINS="*"

# Supabase PostgreSQL Connection String (PgBouncer Pooler)
